{
  "name": "HomeGuard · Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {"openFiles": ["README.md", "streamlit_app.py"]},
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "postAttachCommand": {"server": "python -m streamlit run streamlit_app.py"},
  "portsAttributes": {"8501": {"label": "HomeGuard", "onAutoForward": "openPreview"}},
  "forwardPorts": [8501]
}
